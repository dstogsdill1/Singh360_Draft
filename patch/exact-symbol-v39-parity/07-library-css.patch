diff --git a/frontend/src/styles/libraryV2.css b/frontend/src/styles/libraryV2.css
index 513ffa0..e5923cd 100644
--- a/frontend/src/styles/libraryV2.css
+++ b/frontend/src/styles/libraryV2.css
@@ -479,3 +479,57 @@
 /* S360 WORKSPACE UX V10 component preview fallback */
 .libv2-preview-fallback-name { display:block; max-width:100%; overflow:hidden; text-overflow:ellipsis; }
 .libv2-preview-fallback-reason { display:block; }
+
+
+/* S360 SAVED REFRIGERATION LEGEND CARDS V39 */
+.libv2-saved-legends {
+  margin: 10px 0 0;
+  padding: 10px;
+  border: 1px solid var(--line, #cbd5e1);
+  border-radius: 8px;
+  background: var(--panel, #fff);
+}
+.libv2-saved-legends-head {
+  display: grid;
+  gap: 2px;
+  margin-bottom: 8px;
+}
+.libv2-saved-legends-head span {
+  font-size: 11px;
+  color: var(--muted, #64748b);
+}
+.libv2-saved-legends-grid {
+  display: grid;
+  gap: 7px;
+}
+.libv2-saved-legend-card {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 2px 10px;
+  align-items: center;
+  padding: 9px 10px;
+  text-align: left;
+  border: 1px solid #94a3b8;
+  border-radius: 7px;
+  background: #f8fafc;
+  color: #0f172a;
+  cursor: pointer;
+}
+.libv2-saved-legend-card:hover {
+  border-color: #0284c7;
+  background: #e0f2fe;
+}
+.libv2-saved-legend-card strong,
+.libv2-saved-legend-card em {
+  grid-column: 1;
+}
+.libv2-saved-legend-card span {
+  grid-column: 2;
+  grid-row: 1 / span 2;
+  font-size: 11px;
+}
+.libv2-saved-legend-card em {
+  font-size: 11px;
+  font-style: normal;
+  color: #0369a1;
+}
