+    fill: '#111',
+    editable: true,
+    splitByGrapheme: false,
+  });
+  (labelText as unknown as Record<string, unknown>).legendPartRole = 'label';
+  parts.push(labelText);
+  const group = new Group(parts, { left, top, originX: 'left', originY: 'top', subTargetCheck: true });
+  const rec = group as unknown as Record<string, unknown>;
+  rec.objName = `Symbol ${code || 'Marker'} — ${label}`;
+  rec.isLegendRow = true;
+  rec.legendCode = code;
+  rec.legendLabel = label;
+  rec.legendGlyph = String(row.glyph || code);
+  rec.legendShape = row.shape || (code === 'CC' ? 'square' : 'circle');
+  rec.legendColor = row.color || '#ffd400';
+  rec.legendColor2 = row.color2 || row.color || '#ffd400';
+  rec.legendPattern = row.pattern || 'solid';
+  return group;
+}
