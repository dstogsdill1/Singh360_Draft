+function makeSymbolLegendRow(row: SymbolLegendInsertRow, markerSize: number, left: number, top: number): Group {
+  const code = String(row.code || row.acronym || '').trim().toUpperCase();
+  const label = String(row.label || '').trim();
+  const rowHeight = Math.max(34, markerSize + 8);
+  const parts = makeLegendMarkerParts(row, markerSize, 0, (rowHeight - markerSize) / 2);
+  const labelText = new Textbox(label, {
