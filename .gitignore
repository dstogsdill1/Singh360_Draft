# --- Singh360 Draft ignore rules ---
# Code-only repo. Never commit customer drawings, exports, or secrets.

# Secrets / local env
.env
.env.local
*.key

# Generated outputs
output/

# Web bridge job sandbox
.jobs/

# Live document editor — JSON docs + exported PDFs
.docs/

# Local probes / scratch
_inspect_*.py
_probe_*.py
_verify_*.py
*.xlsx

# Customer / project source material
input_docs/
WORK-FOLDER/
*.pdf
*DO-NOT-SHARE*

# Component library seed + local library (private / customer-derived images)
Singh360_Component_Library_Seed/
.reference_inputs/
.docs/library/
.docs/library_staging/
.docs/projects/
*.zip
*.pptx

# Legacy pipeline artifacts (pre-Draft overhaul)
*.vsdx
*.vson
*.vson.json
*.vsd
*.vssx
*.vss
*.rdm.xml

# Legacy catalog / compliance UI (removed from Draft)
ems/

# Python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Node / frontend local deps
frontend/node_modules/
node_modules/

# Vite / frontend caches
frontend/.vite/
frontend/.cache/

# TypeScript incremental build cache
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# Frontend production build output
frontend/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local personal PowerPoint palette - keep in the working folder, never commit
Singh360_Component_Library_Real*.pptx
Singh360 Component Library Real*.pptx

# Published component catalog - intentionally committed for team access
!docs/component-library/
!docs/component-library/**
