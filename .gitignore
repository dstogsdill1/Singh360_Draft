# --- Singh360_SmartDraw ignore rules ---
# Code-only repo. Never commit customer drawings, exports, or secrets.

# Secrets / local env
.env
.env.local
*.key

# Generated diagram outputs
output/
*.vsdx
*.vson
*.vson.json

# Web bridge job sandbox (uploads + per-run outputs)
.jobs/

# Live document editor — JSON docs + exported PDFs (never commit customer docs)
.docs/

# Local probes / scratch (never customer data in the repo)
_inspect_*.py
_probe_*.py
_verify_*.py
*.xlsx

# Customer / project source material (raw plans, stencils, exports)
input_docs/
WORK-FOLDER/
*.pdf
*.vsd
*.vssx
*.vss
*DO-NOT-SHARE*

# Python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Allow the synthetic demo inputs (explicitly NOT customer data)
!sample_data/
!sample_data/**
