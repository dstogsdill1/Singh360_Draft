# --- Singh360 Draft ignore rules ---
# Code-only repo. Never commit customer drawings, exports, or secrets.

# Secrets / local env
.env
.env.local
*.key

# Generated outputs
output/

# Web bridge job sandbox
.jobs/

# Live document editor — JSON docs + exported PDFs
.docs/

# Local probes / scratch
_inspect_*.py
_probe_*.py
_verify_*.py
*.xlsx

# Customer / project source material
input_docs/
WORK-FOLDER/
*.pdf
*DO-NOT-SHARE*

# Legacy pipeline artifacts (pre-Draft overhaul)
*.vsdx
*.vson
*.vson.json
*.vsd
*.vssx
*.vss
*.rdm.xml

# Legacy catalog / compliance UI (removed from Draft)
ems/

# Python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Allow synthetic demo inputs
!sample_data/
!sample_data/**
