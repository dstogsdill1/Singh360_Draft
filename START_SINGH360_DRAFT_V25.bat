YWluX18iOgogICAgcmFpc2UgU3lzdGVtRXhpdChtYWluKCkpCg==
'@ -replace '\s',''))
)

$codeTargets = @(
    'core\workbook_status_sync.py',
    'core\workbook_link_manager.py',
    'server.py',
    'frontend\src\components\SyncDecisionModal.tsx',
    'frontend\src\components\ProjectDashboard.tsx',
    'core\full_workbook_sync.py'
)

$marker = Join-Path $runtime 'full_workbook_mirror_v25_verified.json'

function Combined-Code-Hash {
    $builder = New-Object System.Text.StringBuilder
    foreach ($relative in $codeTargets) {
        $path = Join-Path $repo $relative
        if (Test-Path $path) {
            [void]$builder.Append((Get-FileHash -Algorithm SHA256 $path).Hash)
        } else {
            [void]$builder.Append('<missing>')
        }
        [void]$builder.Append('|')
    }
    $bytes = [Text.Encoding]::UTF8.GetBytes($builder.ToString())
    $sha = [Security.Cryptography.SHA256]::Create()
    try {
        return ([BitConverter]::ToString($sha.ComputeHash($bytes))).Replace('-', '').ToLowerInvariant()
    }
    finally {
        $sha.Dispose()
    }
}

$alreadyVerified = $false
$currentHash = Combined-Code-Hash
if (Test-Path $marker) {
    try {
        $markerData = Get-Content -Raw $marker | ConvertFrom-Json
        $alreadyVerified = (
            [string]$markerData.combinedHash -eq $currentHash -and
            [string]$markerData.projectId -eq $projectId
        )
    }
    catch {
        $alreadyVerified = $false
    }
}

Write-Host "Repository: $repo"
Write-Host "Project:    $projectId"
Write-Host "Workbook:   $workbook"
Write-Host "Backup:     $backup"
Write-Host ""

Write-Host "Stopping the current Singh360 server..."
foreach ($listener in @(
    Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue
)) {
    $proc = Get-CimInstance Win32_Process -Filter (
        "ProcessId=" + $listener.OwningProcess
    ) -ErrorAction SilentlyContinue
    $cmd = [string]$proc.CommandLine
    if (-not $proc -or $cmd -notmatch '(?i)server\.py') {
        throw "Port $port belongs to an unrelated process. PID $($listener.OwningProcess)"
    }
    Stop-Process -Id $listener.OwningProcess -Force -ErrorAction Stop
}
Start-Sleep -Milliseconds 800

$firstRun = -not $alreadyVerified
if ($firstRun) {
    Write-Host "Creating complete rollback backups..."
    New-Item -ItemType Directory -Path (Join-Path $backup 'code') -Force | Out-Null
    foreach ($relative in $codeTargets) {
        $source = Join-Path $repo $relative
        $destination = Join-Path (Join-Path $backup 'code') $relative
        New-Item -ItemType Directory -Path (Split-Path -Parent $destination) -Force | Out-Null
        if (Test-Path $source) {
            Copy-Item $source $destination -Force
        } else {
            Set-Content ($destination + '.did_not_exist') 'missing before V25' -Encoding UTF8
        }
    }

    Copy-Item $workbook (Join-Path $backup ('workbook_before' + [IO.Path]::GetExtension($workbook))) -Force
    & tar.exe -a -c -f (Join-Path $backup 'project_before.zip') -C (Split-Path -Parent $projectFolder) (Split-Path -Leaf $projectFolder)
    if ($LASTEXITCODE -ne 0 -or -not (Test-Path (Join-Path $backup 'project_before.zip'))) {
        throw 'The complete project-package backup failed. Nothing was changed.'
    }

    & git.exe -C $repo branch --show-current |
        Set-Content (Join-Path $backup 'git-branch.txt') -Encoding UTF8
    & git.exe -C $repo rev-parse HEAD |
        Set-Content (Join-Path $backup 'git-commit.txt') -Encoding UTF8
    & git.exe -C $repo status --short |
        Set-Content (Join-Path $backup 'git-status-before.txt') -Encoding UTF8
    & git.exe -C $repo diff |
        Set-Content (Join-Path $backup 'git-diff-before.patch') -Encoding UTF8
}

$success = $false
try {
    if ($firstRun) {
        Write-Host "Installing the full workbook mirror engine..."
        & $python $patchScript --repo $repo
        if ($LASTEXITCODE -ne 0) {
            throw 'The V25 code patch failed.'
        }

        Write-Host "Compiling backend..."
        Push-Location $repo
        try {
            & $python -m compileall server.py core
            if ($LASTEXITCODE -ne 0) {
                throw 'Backend compilation failed.'
            }
        }
        finally {
            Pop-Location
        }

        Write-Host "Building frontend..."
        $npm = Get-Command npm.cmd -ErrorAction SilentlyContinue
        if (-not $npm) {
            $npm = Get-Command npm.exe -ErrorAction SilentlyContinue
        }
        if (-not $npm) {
            throw 'Node.js / npm was not found.'
        }
        Push-Location (Join-Path $repo 'frontend')
        try {
            & $npm.Source run build
            if ($LASTEXITCODE -ne 0) {
                throw 'Frontend build failed.'
            }
        }
        finally {
            Pop-Location
        }

        Write-Host "Mirroring the complete app base-page manifest into Excel..."
        $result = Join-Path $backup 'FULL_WORKBOOK_MIRROR_RESULT.json'
        $stdout = Join-Path $backup 'verification.stdout.log'
        $stderr = Join-Path $backup 'verification.stderr.log'
        $oldPreference = $ErrorActionPreference
        $ErrorActionPreference = 'Continue'
        try {
            Push-Location $repo
            try {
                & $python $verifyScript `
                    --repo $repo `
                    --project $projectId `
                    --result $result `
                    1> $stdout 2> $stderr
                $verifyCode = $LASTEXITCODE
            }
            finally {
                Pop-Location
            }
        }
        finally {
            $ErrorActionPreference = $oldPreference
        }

        if ($verifyCode -ne 0) {
            Write-Host "--- Verification stdout ---" -ForegroundColor Yellow
            Get-Content $stdout -Tail 240 -ErrorAction SilentlyContinue
            Write-Host "--- Verification stderr ---" -ForegroundColor Yellow
            Get-Content $stderr -Tail 240 -ErrorAction SilentlyContinue
            throw "V25 verification failed with exit code $verifyCode."
        }
        if (-not (
            Select-String `
                -Path $stdout `
                -SimpleMatch 'SINGH360 FULL WORKBOOK MIRROR V25: PASS' `
                -Quiet
        )) {
            throw 'The V25 verifier did not produce its PASS marker.'
        }

        $currentHash = Combined-Code-Hash
        @{
            projectId = $projectId
            verifiedAt = (Get-Date).ToString('o')
            combinedHash = $currentHash
            resultFile = $result
            workbook = $workbook
            syncEngine = 'V25'
        } | ConvertTo-Json |
            Set-Content $marker -Encoding UTF8

        @(
            "Completed: $(Get-Date -Format o)"
            "Project ID: $projectId"
            "Workbook: $workbook"
            "Backup: $backup"
            "Full base-page mirror: PASS"
            "Missing companion worksheets created: PASS"
            "00_INDEX order matches app: PASS"
            "Physical tab order matches app: PASS"
            "Manual data round trip: PASS"
            "Generated continuation rows excluded: PASS"
            "Git commit created: NO"
            "Git push performed: NO"
        ) | Set-Content (Join-Path $backup 'INSTALL_RESULT.txt') -Encoding UTF8
    } else {
        Write-Host "V25 is already installed and verified. Starting the app."
    }

    $stdoutLog = Join-Path $logDir 'singh360-server.stdout.log'
    $stderrLog = Join-Path $logDir 'singh360-server.stderr.log'
    Remove-Item $stdoutLog, $stderrLog -Force -ErrorAction SilentlyContinue

    $serverCommand = (
        'cd /d "' + $repo +
        '" && set "SINGH360_PORT=' + $port +
        '" && set "PYTHONUNBUFFERED=1"' +
        ' && title Singh360 Server - KEEP THIS WINDOW OPEN' +
        ' && "' + $python + '" server.py' +
        ' 1>>"' + $stdoutLog + '"' +
        ' 2>>"' + $stderrLog + '"'
    )
    Write-Host "Starting Singh360 Server..."
    Start-Process -FilePath 'cmd.exe' -ArgumentList @('/k', $serverCommand) -WindowStyle Minimized

    $base = "http://127.0.0.1:$port"
    $deadline = (Get-Date).AddSeconds(120)
    $healthy = $false
    while ((Get-Date) -lt $deadline) {
        try {
            $health = Invoke-RestMethod -Uri "$base/api/health" -TimeoutSec 4
            if ($health.ok -eq $true) {
                $healthy = $true
                break
            }
        }
        catch {
        }
        Start-Sleep -Milliseconds 500
    }
    if (-not $healthy) {
        $tail = if (Test-Path $stderrLog) {
            (Get-Content $stderrLog -Tail 80) -join [Environment]::NewLine
        } else {
            'No server error log.'
        }
        throw "The server did not become healthy.`n$tail"
    }

    $projectsPayload = Invoke-RestMethod -Uri "$base/api/projects" -TimeoutSec 60
    if (@($projectsPayload.projects).Count -lt 1) {
        throw 'Project Home returned no saved projects.'
    }

    $success = $true
    Write-Host ""
    Write-Host "=====================================================================" -ForegroundColor Green
    Write-Host " SINGH360 DRAFT V25 IS READY" -ForegroundColor Green
    Write-Host "=====================================================================" -ForegroundColor Green
    Write-Host "Project Home: PASS" -ForegroundColor Green
    Write-Host "Full workbook mirror: VERIFIED" -ForegroundColor Green
    Write-Host "Daily startup: use this same BAT" -ForegroundColor Green
    Write-Host ""
    Write-Host "Editing status:" -ForegroundColor Yellow
    Write-Host "  PROJECT SAVED LOCALLY - WORKBOOK UPDATE PENDING" -ForegroundColor Yellow
    Write-Host "Finish session with:" -ForegroundColor Yellow
    Write-Host "  Project Home > Review Workbook Sync > Sync Project to Workbook Now" -ForegroundColor Yellow
    Write-Host "Keep the minimized 'Singh360 Server - KEEP THIS WINDOW OPEN' window running." -ForegroundColor Yellow

    Copy-Item $env:S360_SELF (Join-Path $repo 'START_SINGH360_DRAFT_V25.bat') -Force
    Start-Process "http://127.0.0.1:$port/app"
}
catch {
    Write-Host ""
    Write-Host "V25 FAILED: $($_.Exception.Message)" -ForegroundColor Red

    if ($firstRun) {
        Write-Host "Restoring code, complete project package, and workbook..." -ForegroundColor Yellow
        foreach ($listener in @(
            Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue
        )) {
            Stop-Process -Id $listener.OwningProcess -Force -ErrorAction SilentlyContinue
        }

        foreach ($relative in $codeTargets) {
            $source = Join-Path (Join-Path $backup 'code') $relative
            $target = Join-Path $repo $relative
            if (Test-Path $source) {
                New-Item -ItemType Directory -Path (Split-Path -Parent $target) -Force | Out-Null
                Copy-Item $source $target -Force
            } elseif (Test-Path ($source + '.did_not_exist')) {
                Remove-Item $target -Force -ErrorAction SilentlyContinue
            }
        }

        $workbookBackup = Join-Path $backup ('workbook_before' + [IO.Path]::GetExtension($workbook))
        if (Test-Path $workbookBackup) {
            Copy-Item $workbookBackup $workbook -Force
        }

        $failedProject = Join-Path $backup ('failed_project_after_v25_' + $stamp)
        if (Test-Path $projectFolder) {
            Move-Item $projectFolder $failedProject -Force
        }
        & tar.exe -xf (Join-Path $backup 'project_before.zip') -C (Split-Path -Parent $projectFolder)
        if ($LASTEXITCODE -ne 0) {
            Write-Host "WARNING: Automatic project restore failed. Backup: $backup\project_before.zip" -ForegroundColor Red
        } else {
            Write-Host "Rollback completed." -ForegroundColor Yellow
        }

        Remove-Item $marker -Force -ErrorAction SilentlyContinue

        $npm = Get-Command npm.cmd -ErrorAction SilentlyContinue
        if ($npm) {
            Push-Location (Join-Path $repo 'frontend')
            try {
                & $npm.Source run build | Out-Null
            }
            catch {
            }
            finally {
                Pop-Location
            }
        }
    }
    throw
}
finally {
    Remove-Item $payloadDir -Recurse -Force -ErrorAction SilentlyContinue
}

if (-not $success) {
    throw 'Singh360 Draft V25 did not complete.'
}
