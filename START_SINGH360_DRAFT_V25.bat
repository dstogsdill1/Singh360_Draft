@echo off
setlocal EnableExtensions
chcp 65001 >nul
title Singh360 Draft - Full Workbook Mirror V25
set "S360_SELF=%~f0"

echo.
echo =====================================================================
echo  SINGH360 DRAFT - FULL WORKBOOK MIRROR V25
echo  Fixes missing rows/tabs and opens normal Project Home
echo =====================================================================
echo.

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
  "$file=[IO.File]::ReadAllText($env:S360_SELF);" ^
  "$marker=('# S360_'+'POWERSHELL_PAYLOAD');" ^
  "$i=$file.IndexOf($marker);" ^
  "if($i -lt 0){throw 'Embedded PowerShell payload was not found.'};" ^
  "Invoke-Expression $file.Substring($i+$marker.Length)"

set "RC=%ERRORLEVEL%"
echo.
if not "%RC%"=="0" (
  echo V25 FAILED. The exact error is shown above.
  echo First-run failures restore the code, complete project package, and workbook.
) else (
  echo SINGH360 DRAFT V25 IS READY.
)
echo.
pause
exit /b %RC%

# S360_POWERSHELL_PAYLOAD
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$port = 8766
$projectId = 'b0904c99f2404524'
$stamp = Get-Date -Format 'yyyyMMdd_HHmmss'

$repoCandidates = @(
    (Join-Path $env:USERPROFILE 'OneDrive - Homeland Development Services LLC\Desktop\Singh360_SmartDraw'),
    (Join-Path $env:USERPROFILE 'Desktop\Singh360_SmartDraw')
)
$repo = $repoCandidates |
    Where-Object {
        (Test-Path (Join-Path $_ '.git')) -and
        (Test-Path (Join-Path $_ 'server.py'))
    } |
    Select-Object -First 1
if (-not $repo) {
    throw 'Singh360_SmartDraw was not found.'
}
$repo = [IO.Path]::GetFullPath($repo)

$python = Join-Path $repo '.venv\Scripts\python.exe'
if (-not (Test-Path $python)) {
    throw "Project Python was not found: $python"
}

$docs = Join-Path $repo '.docs'
$projectsRoot = Join-Path $docs 'projects'
$runtime = Join-Path $docs 'runtime'
$logDir = Join-Path $docs 'startup_logs'
$backup = Join-Path $docs ("patch_backups\full_workbook_mirror_v25_" + $stamp)
$payloadDir = Join-Path $env:TEMP ("S360_FULL_SYNC_V25_" + $stamp)
New-Item -ItemType Directory -Path $runtime, $logDir, $backup, $payloadDir -Force | Out-Null

$projectMatches = @(
    Get-ChildItem $projectsRoot -Directory -ErrorAction Stop |
    Where-Object {
        $_.Name -match ('__' + [regex]::Escape($projectId) + '$')
    }
)
if ($projectMatches.Count -ne 1) {
    throw "Expected exactly one canonical Mi Tienda 829 project; found $($projectMatches.Count)."
}
$projectFolder = $projectMatches[0].FullName
$projectJson = Join-Path $projectFolder 'project.json'
if (-not (Test-Path $projectJson)) {
    throw "The canonical project.json was not found."
}
$projectData = Get-Content -Raw $projectJson | ConvertFrom-Json
$workbook = [Environment]::ExpandEnvironmentVariables(
    [string]$projectData.workbookSync.workbook
)
if (-not $workbook -or -not (Test-Path $workbook)) {
    throw "The linked workbook was not found: $workbook"
}

$patchScript = Join-Path $payloadDir 'patch-v25.py'
$verifyScript = Join-Path $payloadDir 'verify-v25.py'
