# Singh360_SmartDraw — optional Azure Document Intelligence credentials.
# Copy to ".env" (gitignored) and fill in to enable the live spatial path.
# The deterministic CSV -> VSON/VSDX pipeline does NOT require these.

AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Rasterization DPI for PDF page extraction (live path only).
SMARTDRAW_DPI=200
